root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
spelling_language = en
trim_trailing_whitespace = true

[*.py]
max_line_length = 125

[*.html]
indent_size = 2

[*.rst]
indent_size = 3

[{*.yml,*.yaml}]
indent_size = 2

[{Makefile,*.bat}]
indent_style = tab
indent_size = tab

[{*.markdown,*.md}]
indent_size = 2
trim_trailing_whitespace = false
